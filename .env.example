# ============================================================================
# CRTIC Agenda — variables de entorno
# ============================================================================
# Copia este archivo a .env.local (desarrollo) o configura las variables en
# tu proveedor de hosting (producción). NUNCA commitees .env o .env.local.
# ============================================================================

# ---------- Base de datos ----------
# Postgres 14+ con extensión btree_gist disponible (Neon, Supabase, RDS, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/crtic_agenda?schema=public"

# ---------- Autenticación (NextAuth) ----------
# URL pública de la app (sin trailing slash)
NEXTAUTH_URL="http://localhost:3000"
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ---------- Google OAuth (integración con Calendar — Etapa posterior) ----------
# Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- Correos (Resend — Etapa posterior) ----------
# https://resend.com → API Keys
RESEND_API_KEY=""

# ---------- Cifrado de credenciales (AES-256-GCM) ----------
# Clave de 32 bytes en base64. Genera con: openssl rand -base64 32
# Crítica: si la pierdes, las credenciales cifradas no se podrán descifrar.
# Rotable a través de WeeklyCredential.encryptionKeyVersion.
ENCRYPTION_KEY=""

# ---------- App ----------
APP_URL="http://localhost:3000"
